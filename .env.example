# Cairn Board settings. Copy this file to .env next to docker-compose.yml and
# app.py, then fill it in:   cp .env.example .env
# Docker Compose passes these to the container (env_file); a plain
# `python3 app.py` run reads the same .env. Never commit .env.

# --- Required -----------------------------------------------------------

# Signs everyone's login cookie. Keep it the same between restarts, or every
# player is logged out. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CAIRN_SECRET_KEY=

# The DM's login password for /dm.
CAIRN_DM_PASSWORD=

# --- Docker -------------------------------------------------------------

# The host user and group compose runs the container as. They must own
# ./data. Find them on the host with `id -u` and `id -g`.
PUID=1000
PGID=1000

# Time zone for post timestamps and the activity log.
TZ=America/New_York

# --- Optional -----------------------------------------------------------

# Set to 1 only when a reverse proxy (Caddy, nginx) sits in front, so per-IP
# login limits see each player's real address. Leave blank otherwise:
# without a proxy anyone could fake their address.
CAIRN_BEHIND_PROXY=

# Where game state is saved. The Dockerfile sets /app/data; a plain
# `python3 app.py` run defaults to data/ next to app.py. Rarely needed.
#CAIRN_DATA_DIR=

# Address and port for `python3 app.py` only (waitress in Docker ignores
# them). Defaults: 0.0.0.0 and 5000.
#CAIRN_HOST=0.0.0.0
#CAIRN_PORT=5000
