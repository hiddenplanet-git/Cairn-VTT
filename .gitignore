# Real secrets. Commit .env.example instead.
.env

# Game state written at runtime. data/documents/ (table documents) is
# content and is not ignored.
data/cairn.db*
data/backups/
data/legacy-json/
data/.write-test
# Pre-SQLite state files, in case any are still lying around
data/*.json
data/*.txt
data/*.tmp

# Python caches.
__pycache__/
*.pyc
